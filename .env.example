# Copiar a `.env` y completar. `.env` está en .gitignore y NUNCA se versiona.
# Este archivo solo lleva los nombres de las variables, jamás sus valores.

# ── Django ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
# False por defecto. Activarlo SOLO en tu .env local: con False, Django fuerza
# HTTPS y http://localhost deja de responder.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=America/Santiago

# ── Base de datos ───────────────────────────────────────────────────────
# El host `db` es el nombre del servicio en docker-compose.
DATABASE_URL=postgres://dealcommerce:CAMBIAR@db:5432/dealcommerce
POSTGRES_DB=dealcommerce
POSTGRES_USER=dealcommerce
POSTGRES_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Intentos permitidos por IP en las vistas de sesión y registro.
THROTTLE_AUTENTICACION=20/min

# Solicitudes de acceso por IP desde la portada.
THROTTLE_SOLICITUDES=10/hour

# Contraseña de las cuentas de demostración (python manage.py cuentas_demo).
# Si se deja vacía, el comando genera una al azar y la muestra al terminar.
DEMO_PASSWORD=

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Cloudflare R2 (imágenes de producto) ────────────────────────────────
# Con R2_BUCKET_NAME vacío las fotos se guardan en el disco del contenedor y
# basta MEDIA_BASE_URL. Al llenarlo, las otras cuatro pasan a ser
# obligatorias y el arranque falla si falta alguna.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# El endpoint S3 del bucket: https://<id-de-cuenta>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Por dónde alcanza el navegador a las fotos: un dominio propio conectado al
# bucket, o su subdominio r2.dev. No sirve el endpoint de arriba: un bucket de
# R2 nace privado y su endpoint exige firma, así que las fotos saldrían rotas.
R2_PUBLIC_BASE_URL=
# Desde dónde alcanza el navegador a las imágenes guardadas en disco, mientras
# no haya R2. Sin esto, las fotos llegan con una dirección distinta según quién
# las pida y no cargan en la vitrina.
MEDIA_BASE_URL=http://localhost:8000

# ── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Tienda a la que redirige la raíz del sitio mientras la plataforma no tenga
# portada propia. Sin este valor, / responde 404.
NEXT_PUBLIC_TIENDA_POR_DEFECTO=
# Slug de la tienda que la portada enlaza como ejemplo. Sin este valor, el
# botón lleva al formulario de solicitud en vez de a una tienda.
NEXT_PUBLIC_TIENDA_DE_EJEMPLO=
